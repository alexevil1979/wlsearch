# Application
APP_NAME=wlsearch
APP_ENV=production
APP_DEBUG=false
APP_URL=https://wlsearch.1tlt.ru
APP_TIMEZONE=Europe/Moscow

# Admin session auth (MVP: single admin from env)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password

# Session
SESSION_NAME=wlsearch_sess
SESSION_SECURE=true

# MySQL 5.7
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wlsearch
DB_USERNAME=wlsearch
DB_PASSWORD=change-me-db-password
DB_CHARSET=utf8mb4

# Limits (also editable later via settings table / admin UI)
MAX_PARALLEL_VMS=3
MAX_CREATES_PER_DAY=20
MAX_DAILY_SPEND_RUB=500

# Login rate limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Optional Ops Bearer token (JSON API)
OPS_API_TOKEN=

# Timeweb Cloud (Phase 1)
TIMEWEB_API_TOKEN=
TIMEWEB_API_BASE=https://api.timeweb.cloud/api/v1
TIMEWEB_PRESET_ID=4795
TIMEWEB_OS_ID=99
TIMEWEB_AVAILABILITY_ZONE=spb-3
TIMEWEB_BANDWIDTH=200
TIMEWEB_PROJECT_ID=
# Estimated daily cost per created VM (for MAX_DAILY_SPEND_RUB); 0 = skip spend check
TIMEWEB_PRESET_COST_RUB=0

# Timeouts (seconds)
PROVISION_TIMEOUT_SEC=900
BOOTSTRAP_TIMEOUT_SEC=900
CONTROL_CHECK_TIMEOUT_SEC=300

# Selectel OpenStack (Phase 3)
SELECTEL_AUTH_URL=
SELECTEL_USERNAME=
SELECTEL_PASSWORD=
SELECTEL_PROJECT_ID=
SELECTEL_USER_DOMAIN_NAME=Default
SELECTEL_PROJECT_DOMAIN_NAME=Default
SELECTEL_REGION=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ASN lookup (best-effort, optional)
IPINFO_TOKEN=
