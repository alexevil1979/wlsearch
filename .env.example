# Application
APP_NAME=wlsearch
APP_ENV=production
APP_DEBUG=false
APP_URL=https://wlsearch.1tlt.ru
APP_TIMEZONE=Europe/Moscow

# Admin session auth (MVP: single admin from env)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password

# Session
SESSION_NAME=wlsearch_sess
SESSION_SECURE=true

# MySQL 5.7
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wlsearch
DB_USERNAME=wlsearch
DB_PASSWORD=change-me-db-password
DB_CHARSET=utf8mb4

# Limits (also editable in admin /settings)
MAX_PARALLEL_VMS=3
MAX_CREATES_PER_DAY=20
MAX_DAILY_SPEND_RUB=500

# Login rate limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Optional Ops Bearer token (JSON API)
OPS_API_TOKEN=

# Timeweb Cloud
TIMEWEB_API_TOKEN=
TIMEWEB_API_BASE=https://api.timeweb.cloud/api/v1
TIMEWEB_PRESET_ID=4795
TIMEWEB_OS_ID=99
TIMEWEB_AVAILABILITY_ZONE=spb-3
TIMEWEB_BANDWIDTH=200
TIMEWEB_PROJECT_ID=
TIMEWEB_PRESET_COST_RUB=0

# Timeouts (seconds)
PROVISION_TIMEOUT_SEC=900
BOOTSTRAP_TIMEOUT_SEC=900
CONTROL_CHECK_TIMEOUT_SEC=300
BS_TASK_TTL_SEC=900

# Selectel OpenStack
SELECTEL_AUTH_URL=https://cloud.api.selcloud.ru/identity/v3
SELECTEL_USERNAME=
SELECTEL_PASSWORD=
SELECTEL_PROJECT_ID=
SELECTEL_PROJECT_NAME=
SELECTEL_USER_DOMAIN_NAME=
SELECTEL_PROJECT_DOMAIN_NAME=
SELECTEL_REGION=ru-9a
SELECTEL_FLAVOR_ID=
SELECTEL_IMAGE_ID=
SELECTEL_NETWORK_ID=
# Optional: allocate floating IP from this external network
SELECTEL_EXTERNAL_NET_ID=
SELECTEL_PRESET_COST_RUB=0

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ASN lookup (best-effort, optional)
IPINFO_TOKEN=

# bsbord.com — альтернатива Android SIM для BS-проверки
# https://bsbord.com/v1/probe  Authorization: Bearer bsk_live_...
BSBORD_API_BASE=https://bsbord.com/v1
BSBORD_API_TOKEN=
# Опционально: фильтр op_key через запятую, напр. mts|Мск|on или коротко оставить пустым (= все dpi=on)
BSBORD_OPERATORS=
# agent | bsbord | both — дефолт в форме запуска
BS_MODE_DEFAULT=agent
