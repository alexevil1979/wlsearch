# Application
APP_NAME=wlsearch
APP_ENV=production
APP_DEBUG=false
APP_URL=https://wlsearch.1tlt.ru
APP_TIMEZONE=Europe/Moscow

# Admin session auth (MVP: single admin from env)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-strong-password

# Session
SESSION_NAME=wlsearch_sess
SESSION_SECURE=true

# MySQL 5.7
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wlsearch
DB_USERNAME=wlsearch
DB_PASSWORD=change-me-db-password
DB_CHARSET=utf8mb4

# Limits (also editable in admin /settings)
MAX_PARALLEL_VMS=3
MAX_CREATES_PER_DAY=20
MAX_DAILY_SPEND_RUB=500

# Login rate limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Optional Ops Bearer token (JSON API)
OPS_API_TOKEN=

# Timeweb Cloud
TIMEWEB_API_TOKEN=
TIMEWEB_API_BASE=https://api.timeweb.cloud/api/v1
# VPS: preset (основной). Те же ключи в админке Настройки (settings перекрывают .env)
TIMEWEB_PRESET_ID=4795
TIMEWEB_OS_ID=99
TIMEWEB_AVAILABILITY_ZONE=spb-3
TIMEWEB_BANDWIDTH=200
TIMEWEB_PROJECT_ID=
TIMEWEB_PRESET_COST_RUB=0
# Запасной режим без preset: configuration
TIMEWEB_CONFIGURATOR_ID=
TIMEWEB_CPU=1
TIMEWEB_GPU=0
TIMEWEB_RAM_GB=1
TIMEWEB_DISK_GB=15
TIMEWEB_ENSURE_IPV4=1
TIMEWEB_FLOATING_IP_ID=
TIMEWEB_DELETE_FLOATING_IP_ON_DESTROY=1

# Timeouts (seconds)
PROVISION_TIMEOUT_SEC=900
BOOTSTRAP_TIMEOUT_SEC=900
CONTROL_CHECK_TIMEOUT_SEC=300
BS_TASK_TTL_SEC=900

# Selectel OpenStack
SELECTEL_AUTH_URL=https://cloud.api.selcloud.ru/identity/v3
SELECTEL_USERNAME=
SELECTEL_PASSWORD=
SELECTEL_PROJECT_ID=
SELECTEL_PROJECT_NAME=
SELECTEL_USER_DOMAIN_NAME=
SELECTEL_PROJECT_DOMAIN_NAME=
SELECTEL_REGION=ru-9a
SELECTEL_FLAVOR_ID=
SELECTEL_IMAGE_ID=
SELECTEL_NETWORK_ID=
# Optional: allocate floating IP from this external network
SELECTEL_EXTERNAL_NET_ID=
SELECTEL_PRESET_COST_RUB=0

# Yandex Cloud Compute (основной для перебора IP)
# Ключ сервисного аккаунта целиком (JSON) — удобнее через /accounts
YANDEX_SA_KEY_JSON=
# Либо по частям:
YANDEX_SA_ID=
YANDEX_SA_KEY_ID=
YANDEX_SA_PRIVATE_KEY=
YANDEX_FOLDER_ID=
YANDEX_SUBNET_ID=
YANDEX_ZONE_ID=ru-central1-a
YANDEX_IMAGE_FAMILY=ubuntu-2204-lts
YANDEX_IMAGE_ID=
YANDEX_PLATFORM_ID=standard-v3
YANDEX_CORES=2
YANDEX_MEMORY_GB=2
YANDEX_DISK_GB=15
YANDEX_PREEMPTIBLE=1
YANDEX_PRESET_COST_RUB=0

# Telegram (optional; также в /settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Прокси Bot API (как botfabric). Пусто = без прокси
TELEGRAM_PROXY=socks5h://127.0.0.1:1080

# ASN lookup (best-effort, optional)
IPINFO_TOKEN=

# bsbord.com — альтернатива Android SIM для BS-проверки
# https://bsbord.com/v1/probe  Authorization: Bearer bsk_live_...
BSBORD_API_BASE=https://bsbord.com/v1
BSBORD_API_TOKEN=
# Полные op_key через запятую (только |on = БС). Пусто = авто МегаФон/МТС/Билайн ЦФО БС
BSBORD_OPERATORS=
# Сколько операторов БС должны подтвердить PASS (1 = достаточно одного)
BSBORD_MIN_PASS=1
BS_MODE_DEFAULT=bsbord
